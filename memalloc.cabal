cabal-version:  3.14
name:           memalloc
version:        0.1.0
license:        BSD-3-Clause
author:         Leo D.
maintainer:     leo@haskell.foundation
build-type:     Simple
description:
    Memory and allocation abstractions

flag use-bytestring
    description: Include ByteString support
    manual:      True
    default:     True

common warnings
    ghc-options:
        -Wall
        -Wcompat
        -Wno-ambiguous-fields
        -Wno-unused-imports
        -Wno-unused-local-binds
        -Wno-unused-top-binds
        -Wno-name-shadowing
        -Wno-missing-pattern-synonym-signatures
        -Wno-unused-do-bind
        -Wno-dodgy-exports

common language
    default-language: GHC2021
    default-extensions:
        -- ConstraintKinds
        DataKinds
        DefaultSignatures
        DerivingStrategies
        -- DuplicateRecordFields
        FlexibleContexts
        FlexibleInstances
        -- KindSignatures
        -- NoFieldSelectors
        NoImplicitPrelude
        -- OverloadedStrings
        -- OverloadedRecordDot
        -- QuantifiedConstraints
        ScopedTypeVariables
        TypeFamilies
        -- TypeOperators

common dependencies
    build-depends:
        base >= 4 && < 5
    if flag(use-bytestring)
        build-depends:
            bytestring
        cpp-options: -DUSE_BYTESTRING

common paths
    other-modules:
        Paths_memalloc
    autogen-modules:
        Paths_memalloc
        

